# NEXUS Environment Configuration
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=nexus_super_secret_jwt_key_replace_in_production_iisertirupati_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# For local development with zero dependencies, SQLite is default:
DATABASE_URL=sqlite+aiosqlite:///./nexus.db
SYNC_DATABASE_URL=sqlite:///./nexus.db

# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://nexus:password@localhost:5432/nexus
# SYNC_DATABASE_URL=postgresql://nexus:password@localhost:5432/nexus

STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=52428800

# Optional Cloudinary storage. Leave blank to use local disk storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI requests share a bounded in-process queue before reaching the model.
AI_MAX_CONCURRENT_REQUESTS=8
AI_MAX_QUEUED_REQUESTS=512
AI_QUEUE_TIMEOUT_SECONDS=180

# Install Tectonic (https://tectonic-typesetting.github.io/) to enable full-document LaTeX compilation.
TECTONIC_PATH=tectonic
LATEX_COMPILE_TIMEOUT_SECONDS=45
